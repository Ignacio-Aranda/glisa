# ---- lib/permissions.ts

msgid "Access to your Logitech devices"
msgstr "Acceso a tus dispositivos Logitech"

msgid "A system rule (udev) so your user can read and change their settings without being an administrator"
msgstr "Una regla del sistema (udev) para que tu usuario pueda leer y cambiar sus ajustes sin ser administrador"

msgid "Sending key presses"
msgstr "Envío de pulsaciones de teclas"

msgid "So a mouse button can trigger shortcuts such as copy or switching desktops"
msgstr "Para que un botón del ratón pueda lanzar atajos como copiar o cambiar de escritorio"

msgid "Accessibility"
msgstr "Accesibilidad"

msgid "So buttons can send keyboard shortcuts and Flow can move the pointer"
msgstr "Para que los botones puedan enviar atajos de teclado y Flow pueda mover el puntero"

msgid "Input Monitoring"
msgstr "Monitorización de entrada"

msgid "So {app} can talk to your mice and keyboards"
msgstr "Para que {app} pueda hablar con tus ratones y teclados"

msgid "Local Network"
msgstr "Red local"

msgid "So Flow can find your other computers"
msgstr "Para que Flow pueda encontrar tus otros equipos"

msgid "A Logitech device is connected, but your user isn't allowed to use it."
msgid_plural "{n} Logitech devices are connected, but your user isn't allowed to use them."
msgstr[0] "Hay un dispositivo Logitech conectado, pero tu usuario no tiene permiso para usarlo."
msgstr[1] "Hay {n} dispositivos Logitech conectados, pero tu usuario no tiene permiso para usarlos."

msgid "Permissions have to be installed once so that {app} can see and configure your devices."
msgstr "Hay que instalar los permisos una vez para que {app} pueda ver y configurar tus dispositivos."

msgid "Without access to the virtual keyboard, buttons can't send keyboard shortcuts."
msgstr "Sin acceso al teclado virtual, los botones no pueden enviar atajos de teclado."

msgid "Some permissions are missing: {app} may not work fully."
msgstr "Faltan algunos permisos: puede que {app} no funcione del todo."

msgid "macOS asks you to allow apps that read input devices or send key presses. Turn {app} on in each of these panes of System Settings."
msgstr "macOS pide permiso para las aplicaciones que leen dispositivos de entrada o envían pulsaciones de teclas. Activa {app} en cada uno de estos paneles de los Ajustes del Sistema."

msgid "For security, Linux doesn't let a regular app talk to your mouse directly or send key presses. {app} needs to install a small system rule, just once."
msgstr "Por seguridad, Linux no deja que una aplicación normal hable directamente con el ratón ni envíe pulsaciones de teclas. {app} necesita instalar una pequeña regla del sistema, una sola vez."

