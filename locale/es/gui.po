# ---- gui/pages/home.py
msgid "battery {level}"
msgstr "batería {level}"

msgid "disconnected"
msgstr "desconectado"

msgid "Configure {name}"
msgstr "Configurar {name}"

msgid "Add device"
msgstr "Añadir dispositivo"

msgid "Via Bluetooth or a USB receiver"
msgstr "Por Bluetooth o con receptor USB"

msgid "Add a device"
msgstr "Añadir un dispositivo"

msgid "LinOptions finds the Logitech devices connected to this computer by itself. Connect yours in one of these two ways and it will show up here within seconds."
msgstr "LinOptions detecta solo los dispositivos Logitech que ya están conectados a este equipo. Conéctalo de una de estas dos formas y aparecerá aquí en unos segundos."

msgid "Via Bluetooth"
msgstr "Por Bluetooth"

msgid "Turn on the device and hold down its pairing button (the channel button) until the light blinks quickly"
msgstr "Enciende el dispositivo y mantén pulsado su botón de emparejamiento (el de cambio de canal) hasta que la luz parpadee rápido"

msgid "Open the Bluetooth settings of your system and pick the device from the list"
msgstr "Abre los ajustes de Bluetooth de tu sistema y elige el dispositivo en la lista"

msgid "Come back to LinOptions: there is nothing else to do"
msgstr "Vuelve a LinOptions: no hay que hacer nada más"

msgid "Open Bluetooth settings"
msgstr "Abrir ajustes de Bluetooth"

msgid "With a USB receiver"
msgstr "Con receptor USB"

msgid "Plug the receiver into this computer and turn on the device. If they came together in the box, they are already paired."
msgstr "Conecta el receptor a este equipo y enciende el dispositivo. Si venían juntos de fábrica, ya están emparejados."

msgid "Got it"
msgstr "Entendido"

msgid "A Logitech device is connected, but your user isn't allowed to use it."
msgid_plural "{n} Logitech devices are connected, but your user isn't allowed to use them."
msgstr[0] "Hay un dispositivo Logitech conectado, pero tu usuario no tiene permiso para usarlo."
msgstr[1] "Hay {n} dispositivos Logitech conectados, pero tu usuario no tiene permiso para usarlos."

msgid "Permissions have to be installed once so that LinOptions can see and configure your devices."
msgstr "Hay que instalar los permisos una vez para que LinOptions pueda ver y configurar tus dispositivos."

msgid "Without access to the virtual keyboard, buttons can't send keyboard shortcuts."
msgstr "Sin acceso al teclado virtual, los botones no pueden enviar atajos de teclado."

msgid "Looking for devices…"
msgstr "Buscando dispositivos…"

msgid "Waiting for the service…"
msgstr "Esperando al servicio…"

msgid "Refresh (F5)"
msgstr "Actualizar (F5)"

msgid "Refresh"
msgstr "Actualizar"

msgid "LinOptions uses a background service to talk to your devices. They will show up here as soon as it is running."
msgstr "LinOptions usa un servicio en segundo plano para hablar con tus dispositivos. Aparecerán aquí en cuanto esté en marcha."

msgid "No devices found"
msgstr "No se ha encontrado ningún dispositivo"

msgid "LinOptions looks for Logitech mice and keyboards connected to this computer via Bluetooth or a USB receiver."
msgstr "LinOptions busca ratones y teclados Logitech conectados a este equipo por Bluetooth o con receptor USB."

msgid "How to add a device"
msgstr "Cómo añadir un dispositivo"

msgid "Already connected? Try this"
msgstr "Si ya lo tienes conectado, prueba esto"

msgid "Wake the device up"
msgstr "Despierta el dispositivo"

msgid "Turn it on and move it or press a button: it may be asleep or out of battery"
msgstr "Enciéndelo y muévelo o pulsa un botón: puede estar dormido o sin batería"

msgid "Open Bluetooth"
msgstr "Abrir Bluetooth"

msgid "Check Bluetooth"
msgstr "Comprueba el Bluetooth"

msgid "It has to be on, and the device paired and connected to this computer"
msgstr "Tiene que estar activado, y el dispositivo emparejado y conectado con este equipo"

msgid "Review permissions"
msgstr "Revisar permisos"

msgid "Check the permissions"
msgstr "Revisa los permisos"

msgid "Without them, Linux won't let LinOptions see your devices"
msgstr "Sin ellos, Linux no deja que LinOptions vea tus dispositivos"

msgid "Pick one to set up its buttons, pointer and more"
msgstr "Elige uno para configurar sus botones, el puntero y más"

msgid "Click it to set up its buttons, pointer and more"
msgstr "Haz clic en él para configurar sus botones, el puntero y más"

msgid "The LinOptions background service wasn't running. It usually takes a couple of seconds."
msgstr "El servicio en segundo plano de LinOptions no estaba en marcha. Suele tardar un par de segundos."

msgid "Couldn't start the background service. Try again; if nothing changes, log out and back in."
msgstr "No se ha podido iniciar el servicio en segundo plano. Vuelve a intentarlo; si sigue igual, cierra la sesión y vuelve a entrar."

msgid "There is no connection to the LinOptions background service."
msgstr "No hay conexión con el servicio en segundo plano de LinOptions."

msgid "The service isn't responding"
msgstr "El servicio no responde"

msgid "Fix"
msgstr "Solucionar"

msgid "These devices are simulated: nothing you change affects a real mouse"
msgstr "Los dispositivos son simulados: nada de lo que cambies afecta a un ratón real"

