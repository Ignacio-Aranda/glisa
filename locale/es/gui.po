# ---- gui/onboarding.py
msgid "Turn your mouse off and on again, or unplug it and plug it back in"
msgstr "Apaga y enciende el ratón, o desconéctalo y vuelve a conectarlo"

msgid "Permissions"
msgstr "Permisos"

msgid "Permission to use your devices"
msgstr "Permiso para usar tus dispositivos"

msgid "For security, Linux doesn't let a regular app talk to your mouse directly or send key presses. LinOptions needs to install a small system rule, just once."
msgstr "Por seguridad, Linux no deja que una aplicación normal hable directamente con el ratón ni envíe pulsaciones de teclas. LinOptions necesita instalar una pequeña regla del sistema, una sola vez."

msgid "What gets installed, and why"
msgstr "Qué se instala y para qué"

msgid "Access to your Logitech devices"
msgstr "Acceso a tus dispositivos Logitech"

msgid "A system rule (udev) so your user can read and change their settings without being an administrator"
msgstr "Una regla del sistema (udev) para que tu usuario pueda leer y cambiar sus ajustes sin ser administrador"

msgid "Sending key presses"
msgstr "Envío de pulsaciones de teclas"

msgid "So a mouse button can trigger shortcuts such as copy or switching desktops"
msgstr "Para que un botón del ratón pueda lanzar atajos como copiar o cambiar de escritorio"

msgid "Nothing else"
msgstr "Nada más"

msgid "No new software is installed, and LinOptions keeps running as your user"
msgstr "No se instala ningún programa nuevo y LinOptions sigue funcionando con tu usuario"

msgid "Show manual command"
msgstr "Ver comando manual"

msgid "Hide manual command"
msgstr "Ocultar comando manual"

msgid "Copy command"
msgstr "Copiar comando"

msgid "Not now"
msgstr "Ahora no"

msgid "Install permissions"
msgstr "Instalar permisos"

msgid "Your system will ask for your administrator password"
msgstr "El sistema te pedirá tu contraseña de administrador"

msgid "Command copied"
msgstr "Comando copiado"

msgid "Waiting for you to enter your password in the system window…"
msgstr "Esperando a que escribas tu contraseña en la ventana del sistema…"

msgid "All set"
msgstr "Listo"

msgid "Installation cancelled"
msgstr "Instalación cancelada"

msgid "Nothing was changed. You can try again whenever you like."
msgstr "No se ha cambiado nada. Puedes intentarlo de nuevo cuando quieras."

msgid "Couldn't install the permissions"
msgstr "No se han podido instalar los permisos"

msgid "Try again, or use the manual command in a terminal."
msgstr "Prueba otra vez o usa el comando manual en una terminal."

msgid "Retry"
msgstr "Reintentar"

msgid "Done"
msgstr "Hecho"

msgid "Your system can't ask for the password from here. Copy this command, paste it into a terminal, then turn your mouse off and on again."
msgstr "Tu sistema no permite pedir la contraseña desde aquí. Copia este comando, pégalo en una terminal y después apaga y enciende el ratón."

msgid "If you prefer, copy this command, paste it into a terminal, then turn your mouse off and on again."
msgstr "Si lo prefieres, copia este comando, pégalo en una terminal y después apaga y enciende el ratón."

msgid "The installation was interrupted. Try again, or use the manual command."
msgstr "La instalación se ha interrumpido. Prueba otra vez o usa el comando manual."

msgid "Your password couldn't be verified, or your user can't administer this computer. Use the manual command with an administrator account."
msgstr "No se ha podido comprobar tu contraseña o tu usuario no puede administrar este equipo. Usa el comando manual con un usuario administrador."

msgid "Something went wrong during the installation. Try again, or use the manual command in a terminal."
msgstr "Algo ha fallado durante la instalación. Prueba otra vez o usa el comando manual en una terminal."

msgid "Couldn't open the password window of your system. Use the manual command in a terminal."
msgstr "No se ha podido abrir la ventana de contraseña del sistema. Usa el comando manual en una terminal."

