{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glisa",
  "mainBinaryName": "glisa",
  "identifier": "io.github.ignacioaranda.glisa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeBundleCommand": "cargo build --release -p glisa-ctl"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Configure Logitech mice and keyboards",
    "longDescription": "Buttons, gestures, pointer speed, scrolling, Easy-Switch and Flow for Logitech mice and keyboards on Linux, Windows and macOS.",
    "copyright": "Glisa contributors, GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/Ignacio-Aranda/glisa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/70-glisa.rules": "linux/70-glisa.rules",
          "/usr/share/metainfo/io.github.ignacioaranda.glisa.metainfo.xml": "linux/io.github.ignacioaranda.glisa.metainfo.xml",
          "/usr/bin/glisa-ctl": "../../target/release/glisa-ctl"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-glisa.rules": "linux/70-glisa.rules",
          "/usr/share/metainfo/io.github.ignacioaranda.glisa.metainfo.xml": "linux/io.github.ignacioaranda.glisa.metainfo.xml",
          "/usr/bin/glisa-ctl": "../../target/release/glisa-ctl"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "macos/Info.plist",
      "entitlements": "macos/entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
